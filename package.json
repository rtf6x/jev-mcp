{
  "name": "jev-mcp",
  "version": "0.1.4",
  "private": true,
  "description": "MCP server that forwards Jev judgments to the configured Jev endpoint",
  "license": "MIT",
  "workspaces": [
    "mcp-server",
    "mcpb",
    "desktop-app"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "npm start --workspace mcp-server",
    "stdio": "npm run stdio --workspace mcp-server",
    "typecheck": "npm run typecheck --workspace mcp-server",
    "test": "npm test --workspace mcp-server",
    "build": "npm run build --workspace mcp-server",
    "pack:mcpb": "npm run pack --workspace mcpb",
    "sidecar": "npm run sidecar --workspace mcp-server --",
    "desktop": "npm run build --workspace desktop-app",
    "desktop:dev": "npm run dev --workspace desktop-app",
    "icons": "node tools/build-icons.mjs",
    "icons:draw": "node tools/generate-icon.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
