{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jev MCP",
  "version": "0.1.0",
  "identifier": "cc.rootfox.jev-mcp-desktop",
  "build": {
    "frontendDist": "../frontend-stub"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis", "appimage", "deb"],
