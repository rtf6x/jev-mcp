<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Applied to every signed target in the bundle: the tray app and the sidecar
       alike. The sidecar embeds Node, and V8 needs to map JIT pages; under the
       hardened runtime (required for notarization) that mapping is denied without
       these two entitlements, and the sidecar starts but never binds its port -
       a silent hang rather than a crash. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
