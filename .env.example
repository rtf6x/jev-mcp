# Jev MCP configuration. Copy to .env and fill in.
#
# The endpoint is used verbatim: no provider table, no path rewriting.
#   TypeSafe (official)      https://api.typesafe.ai/v1/systemone
#   OpenRouter               https://openrouter.ai/api/alpha/decisions
#   Vercel AI Gateway        https://ai-gateway.vercel.sh/v1/evaluate
JEV_URL=https://api.typesafe.ai/v1/systemone

# Bearer key for that endpoint (TypeSafe: console.typesafe.ai/keys).
JEV_API_KEY=

# Model id sent in the request body. Any model the endpoint serves: one Vercel AI Gateway URL
# serves three evaluation models — typesafe-ai/jev, convaiinnovations/laya, liquid/d1.
JEV_MODEL=jev-latest

# Spelling of a yes/no question for this endpoint:
#   noul    TypeSafe, OpenRouter
#   boolean Vercel AI Gateway
JEV_QUESTION_TYPE=noul

# MCP server
MCP_HOST=127.0.0.1
MCP_HTTP_PORT=18791

# Whole-request deadline for the upstream call, milliseconds.
JEV_TIMEOUT_MS=60000
